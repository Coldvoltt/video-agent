# Required: transcription, the editing agent and reference analysis
OPENAI_API_KEY=sk-your-api-key-here

# Optional: stock B-roll (free key at pixabay.com/api/docs). PEXELS_API_KEY also works if you have one.
# PIXABAY_API_KEY=

# Optional (defaults shown)
# EDITOR_IMAGE_MODEL=gpt-image-2.5-flare
# EDITOR_AGENT_MODEL=gpt-5-mini
# EDITOR_AGENT_REASONING=low
# EDITOR_LLM_PROVIDER=openai
# EDITOR_DB_PATH=output/data.db
# EDITOR_STORAGE_ROOT=output/editor
# EDITOR_MAX_UPLOAD_BYTES=4294967296
# ALLOWED_ORIGINS=http://localhost:3000
# YTDLP_COOKIES_FILE=/path/outside/the/repo/cookies.txt
# FFMPEG_BINARY=/usr/bin/ffmpeg
# FFPROBE_BINARY=/usr/bin/ffprobe

# Background removal (MODNet). The model downloads on first use; point this at a local copy to skip that.
# EDITOR_MODNET_PATH=/path/to/modnet.onnx
# Matting speed vs quality: frames per second matted and the short side the model sees (512 is sharper, ~2x slower).
# EDITOR_MATTE_FPS=15
# EDITOR_MATTE_SIZE=448
# Largest short side of stored cut-outs (lower is faster)
# EDITOR_CUTOUT_SIZE=1080

# Accounts. Require sign-in for the editor (anonymous use is refused); recommended for anything public.
# EDITOR_REQUIRE_ACCOUNT=1
# Mark the session cookie Secure (HTTPS only). Turn on when the site is served over HTTPS.
# EDITOR_SECURE_COOKIES=1

# Plans and vid-coins. Billing is on unless this is 0 (then every feature is unlocked and exports are free).
# EDITOR_BILLING=1
# Fixed Naira prices (USD prices are $3 Basic, $10 Pro).
# EDITOR_PRICE_BASIC_NGN=4500
# EDITOR_PRICE_PRO_NGN=15000
